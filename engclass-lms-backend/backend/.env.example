# ==== Server ====
PORT=5000
NODE_ENV=development
# URL frontend (dipakai untuk konfigurasi CORS; pisahkan beberapa origin dengan koma)
FRONTEND_URL=http://localhost:5173

# ==== Database (PostgreSQL) ====
# Lihat README.md bagian "Setup Database" untuk cara mendapatkan nilai ini
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lms_english?schema=public"

# ==== JWT ====
JWT_SECRET=ganti_dengan_string_acak_yang_panjang_dan_rahasia
JWT_EXPIRES_IN=7d

# ==== Google OAuth ====
# Dari Google Cloud Console > Credentials > OAuth Client ID (tipe Web application)
# WAJIB SAMA PERSIS dengan Client ID yang dipakai di frontend (lihat PRD §29.13)
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# ==== Midtrans Sandbox ====
# Dari dashboard.sandbox.midtrans.com > Settings > Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ==== Cloudinary ====
# Dari dashboard Cloudinary > Dashboard (Cloud name, API Key, API Secret)
CLOUDINARY_CLOUD_NAME=xxxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxx
