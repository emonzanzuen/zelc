# URL base API backend (Express), sesuai §29 PRD: base path /api/v1 sudah termasuk di sini
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Client ID dari Google Cloud Console (OAuth) - harus sama persis dengan yang dipakai backend
VITE_GOOGLE_CLIENT_ID=

# Set "true" untuk memakai data dummy (tanpa backend), "false" bila backend sudah siap
VITE_USE_MOCK=true
